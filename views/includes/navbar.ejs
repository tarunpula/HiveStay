<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    margin-left: 40px;
  }
  .filter {
    text-align: center;
    margin: 10px;
    opacity: 0.7;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .btn-search {
    background-color: #fe424d;
    color: #fff;
  }
  .btn-search:hover {
    background-color: #fe424d;
    color: #fff;
  }
  .btn-search i {
    display: inline;
    margin-right: 10px;
  }
  .rotate-laptop {
    display: inline-block;
    animation: spin 2s infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
/* White background for navbar dropdown menu when open */
@media (max-width: 767.98px) {
  .navbar-collapse.collapse {
    transition: all 0.3s ease-out;  /* Smooth transition for opening/closing */
  }

  .navbar-collapse.collapse.show {
    background-color: white;
    padding: 1rem;
    border-radius: 0 0 10px 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }
}

</style>



<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass rotate-laptop"></i>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <div class="mt-3 ms-2">
          <a class="nav-link" href="/listings">Explore</a>
        </div>
        <div id="filters">
          <div class="filter"><div><i class="fa-solid fa-fire"></i></div><p>Trending</p></div>
          <div class="filter"><div><i class="fa-solid fa-bed"></i></div><p>Beds</p></div>
          <div class="filter"><div><i class="fa-solid fa-mountain-city"></i></div><p>Iconic Cities</p></div>
          <div class="filter"><div><i class="fa-solid fa-mountain"></i></div><p>Mountains</p></div>
          <div class="filter"><div><i class="fa-solid fa-person-hiking"></i></div><p>Hiking</p></div>
          <div class="filter"><div><i class="fa-solid fa-person-swimming"></i></div><p>Swimming</p></div>
        </div>
        <div class="search">
          <form class="d-flex mt-4 ms-5" action="/searching" method="GET">
            <input class="form-control me-2" type="text" placeholder="Search City" name="city" aria-label="Search">
            <button class="btn btn-search"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
          </form>
        </div>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">HiveStay Stay as Your Home</a>
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if (currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

